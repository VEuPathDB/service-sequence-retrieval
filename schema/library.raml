types:
  DeflineFormat:
    type: string
    enum:
      - QUERYONLY
      - REGIONONLY
      - QUERYANDREGION
  Feature:
    type: object
    additionalProperties: false
    properties:
      contig: string
      start: integer
      end: integer
      query?: string
      strand?:
        type: Strand
        default: 'NONE'
  GeneTreeFormat:
    type: string
    enum:
      - newick
  GeneTreeOptions:
    type: object
    additionalProperties: false
    properties:
      format?:
        type: GeneTreeFormat
        default: 'newick'
  JobDataResponse: any
  JobResponse:
    type: object
    additionalProperties: false
    properties:
      jobID:
        type: string
        pattern: ^[\dA-Fa-f]{32}$
        minLength: 32
        maxLength: 32
      status: JobStatus
      queuePosition?:
        type: integer
        format: int32
      created?:
        description: Time the job was submitted. Absent if not yet available.
        type: datetime
      started?:
        description: Time a worker picked up the job. Absent if not yet started.
        type: datetime
      finished?:
        description: Time the job finished. Absent if not yet finished.
        type: datetime
  JobStatus:
    type: string
    enum:
      - queued
      - in-progress
      - complete
      - failed
      - expired
  MsaFormat:
    type: string
    enum:
      - fasta
      - clustal
      - clustal_dnd
      - msf
      - phylip
      - selex
      - stockholm
      - vienna
  MsaOptions:
    type: object
    additionalProperties: false
    properties:
      format:
        type: MsaFormat
        default: 'clustal'
      metadataUrl?:
        description: |
          Optional URL to fetch metadata for sequence annotations.
          Currently only supported with 'clustal' format.

          Expected format: Tab-delimited with header row.
          Example:
            ID	sample_type	culture_type	country
            SEQ1	isolate	axenic	USA
            SEQ2	strain	mixed	Brazil

          Future implementation will display metadata as tooltips
          on sequence IDs in HTML output.
        type: string
  PlainTextFastaResponse: object
  PostProcessType:
    type: string
    enum:
      - MSA
      - GENETREE
  SequencePostRequest:
    type: object
    additionalProperties: false
    properties:
      features:
        type: array
        items: Feature
      deflineFormat?:
        type: DeflineFormat
        default: 'REGIONONLY'
      basesPerLine?:
        type: integer
        default: 60
      percentActg?:
        description: |
          Minimum percentage (0-100) of A/C/T/G bases a sequence must
          contain to be included in the response. Sequences below this
          threshold are skipped rather than causing downstream
          post-processing (e.g. MSA) to fail. A value of 0 (the default)
          disables filtering. Ignored when the sequence type is protein.
        type: integer
        default: 0
      postProcess?: PostProcessType
      msaOptions?: MsaOptions
      geneTreeOptions?: GeneTreeOptions
  SequenceRetrievalSpec:
    type: object
    additionalProperties: false
    properties:
      features:
        type: array
        items: Feature
      featuresStr: string
      featuresUrl: string
      fileFormat: SupportedFileFormat
      uploadMethod: UploadMethod
      startOffset: StartOffset
      deflineFormat: DeflineFormat
      basesPerLine: integer
      percentActg: integer
      sequenceType: string
      postProcess: PostProcessType
      msaOptions: MsaOptions
      geneTreeOptions: GeneTreeOptions
  StartOffset:
    type: string
    enum:
      - ZERO
      - ONE
  Strand:
    type: string
    enum:
      - POSITIVE
      - NEGATIVE
      - NONE
  SupportedFileFormat:
    type: string
    enum:
      - bed
      - gff3
  UploadMethod:
    type: string
    enum:
      - file
      - url

